---
import Layout from '../layouts/Layout.astro';
import { isConfigured, checkPassword, isLoggedIn, logIn, logOut } from '../lib/auth.js';
import { getEvents, addEvent, deleteEvent, hasDatabase } from '../lib/events.js';
import { getLinksForAdmin, parseLinks, saveLinks } from '../lib/links.js';

export const prerender = false;

const MAX = { title: 100, location: 150, description: 500 };
let error = '';
let notice = Astro.url.searchParams.get('saved') ? 'Saved.' : '';

if (Astro.request.method === 'POST' && isConfigured()) {
  const form = await Astro.request.formData();
  const action = form.get('action');
  const clean = (name) => String(form.get(name) ?? '').trim();

  if (action === 'login') {
    if (await checkPassword(form.get('password'))) {
      await logIn(Astro.cookies);
      return Astro.redirect('/admin');
    }
    error = 'Wrong password.';
  } else if (await isLoggedIn(Astro.cookies)) {
    if (action === 'logout') {
      logOut(Astro.cookies);
      return Astro.redirect('/admin');
    } else if (action === 'delete' && hasDatabase) {
      await deleteEvent(clean('id'));
      return Astro.redirect('/admin?saved=1');
    } else if (action === 'saveLinks' && hasDatabase) {
      const result = parseLinks(clean('links'));
      if (result.error) {
        error = result.error;
      } else {
        await saveLinks(result.links);
        return Astro.redirect('/admin?saved=1');
      }
    } else if (action === 'add' && hasDatabase) {
      const event = {
        title: clean('title').slice(0, MAX.title),
        date: clean('date'),
        time: clean('time'),
        location: clean('location').slice(0, MAX.location),
        description: clean('description').slice(0, MAX.description)
      };
      if (!event.title || !/^\d{4}-\d{2}-\d{2}$/.test(event.date) || !/^\d{2}:\d{2}$/.test(event.time)) {
        error = 'Title, date and time are required.';
      } else {
        await addEvent(event);
        return Astro.redirect('/admin?saved=1');
      }
    }
  }
}

const loggedIn = await isLoggedIn(Astro.cookies);
const events = loggedIn ? await getEvents() : [];
const links = loggedIn ? await getLinksForAdmin() : [];
// Safe to embed in a <script type="application/json"> block.
const linksJson = JSON.stringify(links).replace(/</g, '\\u003c');
const when = (iso) =>
  new Intl.DateTimeFormat('en-US', {
    timeZone: 'America/New_York', dateStyle: 'full', timeStyle: 'short'
  }).format(new Date(iso));

Astro.response.headers.set('Cache-Control', 'no-store');
---

<Layout title="Admin - Staffordshire RVA" description="Manage events" noindex>
  <section class="admin">
    <h1 class="profile-name">Admin</h1>

    {!isConfigured() && <p class="admin-error">Set the ADMIN_PASSWORD environment variable to enable this page.</p>}
    {error && <p class="admin-error" role="alert">{error}</p>}
    {notice && <p class="admin-notice" role="status">{notice}</p>}

    {isConfigured() && !loggedIn && (
      <form method="post" class="admin-form">
        <input type="hidden" name="action" value="login">
        <label>Password <input type="password" name="password" required autocomplete="current-password"></label>
        <button type="submit">Log in</button>
      </form>
    )}

    {loggedIn && (
      <>
        {!hasDatabase && <p class="admin-error">Redis is not connected, so events cannot be saved yet.</p>}

        <h2 class="section-heading">Add an event</h2>
        <form method="post" class="admin-form">
          <input type="hidden" name="action" value="add">
          <label>Title <input name="title" required maxlength={MAX.title}></label>
          <label>Date <input type="date" name="date" required></label>
          <label>Start time <input type="time" name="time" required></label>
          <label>Location <input name="location" maxlength={MAX.location}></label>
          <label>Description <textarea name="description" rows="3" maxlength={MAX.description}></textarea></label>
          <button type="submit" disabled={!hasDatabase}>Add event</button>
        </form>

        <h2 class="section-heading">Upcoming events</h2>
        {events.length === 0 && <p class="admin-empty">None yet.</p>}
        {events.map((e) => (
          <form method="post" class="admin-event">
            <input type="hidden" name="action" value="delete">
            <input type="hidden" name="id" value={e.id}>
            <div>
              <strong>{e.title}</strong><br>
              <span>{when(e.start)}</span>
            </div>
            {e.id && <button type="submit" disabled={!hasDatabase}>Delete</button>}
          </form>
        ))}

        <h2 class="section-heading">Links</h2>
        <p class="admin-help">Drag the &#8801; handle, or use the arrows, to reorder. Nothing changes on the site until you press Save links.</p>
        <form method="post" id="links-form" class="admin-form">
          <input type="hidden" name="action" value="saveLinks">
          <input type="hidden" name="links" id="links-field">
          <ul id="links-list" class="links-editor"></ul>
          <div class="links-editor-actions">
            <button type="button" id="add-link">Add link</button>
            <button type="button" id="add-heading">Add heading</button>
          </div>
          <button type="submit" disabled={!hasDatabase}>Save links</button>
        </form>
        <script type="application/json" id="links-data" set:html={linksJson}></script>

        <form method="post" class="admin-logout">
          <input type="hidden" name="action" value="logout">
          <button type="submit">Log out</button>
        </form>
      </>
    )}
  </section>
</Layout>

<script is:inline>
  (function () {
    var dataEl = document.getElementById('links-data');
    if (!dataEl) return;
    var list = document.getElementById('links-list');
    var field = document.getElementById('links-field');
    var items = JSON.parse(dataEl.textContent);

    function el(tag, attrs, children) {
      var node = document.createElement(tag);
      Object.keys(attrs || {}).forEach(function (k) {
        if (k === 'text') node.textContent = attrs[k];
        else node.setAttribute(k, attrs[k]);
      });
      (children || []).forEach(function (c) { node.appendChild(c); });
      return node;
    }

    function labeled(label, input) {
      return el('label', {}, [el('span', { text: label }), input]);
    }

    function textInput(name, value, extra) {
      var input = el('input', Object.assign({ type: 'text', 'data-field': name }, extra || {}));
      input.value = value || '';
      return input;
    }

    function button(text, label, onClick) {
      var b = el('button', { type: 'button', 'aria-label': label, text: text });
      b.addEventListener('click', onClick);
      return b;
    }

    function buildRow(item) {
      var isLink = item.type === 'link';
      var li = el('li', { class: 'links-row ' + (isLink ? 'is-link' : 'is-heading'), 'data-type': item.type });
      var handle = el('span', { class: 'links-handle', 'aria-hidden': 'true', title: 'Drag to reorder', text: '\u2261' });

      var fields = el('div', { class: 'links-fields' }, [
        el('strong', { class: 'links-kind', text: isLink ? 'Link' : 'Heading' }),
        labeled('Title', textInput('title', item.title, { maxlength: '150', required: 'required' }))
      ]);
      if (isLink) {
        fields.appendChild(labeled('Web address', textInput('url', item.url, { type: 'url', maxlength: '2000', required: 'required' })));
        fields.appendChild(labeled('Icon (emoji)', textInput('icon', item.icon, { maxlength: '8' })));
      }
      fields.appendChild(labeled('Description (optional)', textInput('description', item.description, { maxlength: '300' })));
      if (isLink) {
        var box = el('input', { type: 'checkbox', 'data-field': 'highlight' });
        box.checked = item.highlight === true;
        fields.appendChild(el('label', { class: 'links-check' }, [box, el('span', { text: 'Highlight' })]));
      }

      var controls = el('div', { class: 'links-controls' }, [
        button('\u2191', 'Move up', function () { if (li.previousElementSibling) list.insertBefore(li, li.previousElementSibling); }),
        button('\u2193', 'Move down', function () { if (li.nextElementSibling) list.insertBefore(li.nextElementSibling, li); }),
        button('Delete', 'Delete', function () { if (confirm('Delete "' + (li.querySelector('[data-field=title]').value || 'this item') + '"?')) li.remove(); })
      ]);

      li.appendChild(handle);
      li.appendChild(fields);
      li.appendChild(controls);

      // Only draggable while the handle is held, so text inputs stay selectable.
      handle.addEventListener('mousedown', function () { li.draggable = true; });
      handle.addEventListener('mouseup', function () { li.draggable = false; });
      li.addEventListener('dragstart', function (e) {
        e.dataTransfer.effectAllowed = 'move';
        e.dataTransfer.setData('text/plain', '');
        li.classList.add('dragging');
      });
      li.addEventListener('dragend', function () {
        li.draggable = false;
        li.classList.remove('dragging');
      });
      return li;
    }

    list.addEventListener('dragover', function (e) {
      var dragging = list.querySelector('.dragging');
      if (!dragging) return;
      e.preventDefault();
      var after = null;
      var rows = Array.prototype.filter.call(list.children, function (r) { return r !== dragging; });
      for (var i = 0; i < rows.length; i++) {
        var box = rows[i].getBoundingClientRect();
        if (e.clientY < box.top + box.height / 2) { after = rows[i]; break; }
      }
      list.insertBefore(dragging, after);
    });

    items.forEach(function (item) { list.appendChild(buildRow(item)); });

    function addItem(item) {
      var row = buildRow(item);
      list.appendChild(row);
      row.querySelector('[data-field=title]').focus();
    }
    document.getElementById('add-link').addEventListener('click', function () { addItem({ type: 'link' }); });
    document.getElementById('add-heading').addEventListener('click', function () { addItem({ type: 'heading' }); });

    document.getElementById('links-form').addEventListener('submit', function () {
      var out = Array.prototype.map.call(list.children, function (li) {
        var get = function (name) { var i = li.querySelector('[data-field=' + name + ']'); return i ? i.value : undefined; };
        var box = li.querySelector('[data-field=highlight]');
        return {
          type: li.getAttribute('data-type'),
          title: get('title'),
          url: get('url'),
          icon: get('icon'),
          description: get('description'),
          highlight: box ? box.checked : false
        };
      });
      field.value = JSON.stringify(out);
    });
  })();
</script>
