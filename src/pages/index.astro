---
import Layout from '../layouts/Layout.astro';
import LinkItem from '../components/LinkItem.astro';
import Section from '../components/Section.astro';
import { getLinks } from '../lib/links.js';
import { getEvents } from '../lib/events.js';

export const prerender = false;

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');

const [events, linksData] = await Promise.all([getEvents(), getLinks()]);
const tz = 'America/New_York';
const part = (d, opts) => new Intl.DateTimeFormat('en-US', { timeZone: tz, ...opts }).format(d);
const upcomingEvents = events.map((e) => {
    const d = new Date(e.start);
    return {
      ...e,
      month: part(d, { month: 'short' }),
      day: part(d, { day: 'numeric' }),
      weekday: part(d, { weekday: 'long' }),
      time: part(d, { hour: 'numeric', minute: '2-digit' }).replace(' AM', ' am').replace(' PM', ' pm'),
    };
  });
---

<Layout 
  title="Staffordshire RVA - Community Links" 
  description="Staffordshire RVA neighborhood information and community links"
>
  <section class="profile" aria-labelledby="neighborhood-name">
    <h1 id="neighborhood-name" class="profile-name">Staffordshire RVA</h1>
    <p class="profile-bio">Staffordshire is a neighborhood of Richmond, Virginia, just south of the James River, near Bon Air.</p>
  </section>
  
  {upcomingEvents.length > 0 && (
    <section class="events-section" aria-labelledby="events-heading">
      <h2 id="events-heading" class="visually-hidden">Upcoming Event</h2>
      {upcomingEvents.map((event) => (
        <article class="event-card" data-hide-after={event.hideAfter}>
          <div class="event-date" aria-hidden="true">
            <span class="event-month">{event.month}</span>
            <span class="event-day">{event.day}</span>
          </div>
          <div class="event-details">
            <p class="event-label">Upcoming Event</p>
            <h3 class="event-title">{event.title}</h3>
            <p class="event-meta">{event.weekday}, {event.month} {event.day} &middot; {event.time}</p>
            {event.location && <p class="event-meta">{event.location}</p>}
            {event.description && <p class="event-description">{event.description}</p>}
          </div>
        </article>
      ))}
    </section>
  )}

  <section class="links-section" aria-labelledby="community-links-heading">
    <h2 id="community-links-heading" class="visually-hidden">Staffordshire RVA</h2>
    <nav class="links-container" role="navigation" aria-label="Community resources and links">
      {linksData.map((item, index) => {
        if (item.type === 'heading') {
          return <Section title={item.title} description={item.description} index={index} />;
        } else if (item.type === 'link') {
          return <LinkItem 
            title={item.title} 
            url={item.url} 
            description={item.description} 
            icon={item.icon} 
            highlight={item.highlight}
          />;
        }
      })}
    </nav>
  </section>
  
  <section class="contact-section" aria-labelledby="contact-heading">
    <h2 id="contact-heading" class="section-heading">Contact Us</h2>
    <p>For questions or to get involved, please contact the admins of our Facebook group.</p>
  </section>

  <section class="qr-section" aria-labelledby="qr-heading">
    <h2 id="qr-heading" class="section-heading">Share This Site</h2>
    <img src="/qr.svg" alt="QR code linking to staffordshirerva.org" class="qr-code" width="200" height="200">
    <p class="qr-url">staffordshirerva.org</p>
  </section>
</Layout>

<script is:inline>
  // Hide expired events even if the page was built before they expired.
  var now = new Date();
  document.querySelectorAll('[data-hide-after]').forEach(function (el) {
    if (new Date(el.getAttribute('data-hide-after')) <= now) el.remove();
  });
  var section = document.querySelector('.events-section');
  if (section && !section.querySelector('.event-card')) section.remove();
</script>